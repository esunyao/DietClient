<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃表面 - soft 变体（字段卡）：半透明白填充 + 细白描边 + 顶部 3dp 高光。
     圆角基准 26dp，运行时由 AndroidGlassSurface 按 cornerRadius 属性动态调整。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_soft_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_soft_border" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/glass_sheen"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
