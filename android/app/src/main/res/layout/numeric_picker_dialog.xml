<?xml version="1.0" encoding="utf-8"?>
<!-- 数值选择器底部弹窗。行为逻辑见 NumericPickerModule.kt；tools: 属性仅供 Layout Editor 预览。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_picker_sheet"
    android:paddingLeft="20dp"
    android:paddingTop="10dp"
    android:paddingRight="20dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_picker_handle" />

    <TextView
        android:id="@+id/np_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="21sp"
        android:textStyle="bold"
        android:textColor="@color/picker_title_text"
        tools:text="目标体重" />

    <TextView
        android:id="@+id/np_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/picker_accent"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        tools:text="65.0 kg" />

    <FrameLayout
        android:id="@+id/np_wheel_frame"
        android:layout_width="match_parent"
        android:layout_height="190dp">

        <!-- 带一位小数的双滚轮形态（默认预览此形态；运行时由 Kotlin 切换） -->
        <LinearLayout
            android:id="@+id/np_row_tenths"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:orientation="horizontal"
            android:gravity="center"
            tools:visibility="visible">

            <NumberPicker
                android:id="@+id/np_wheel_int"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_weight="1.35" />

            <NumberPicker
                android:id="@+id/np_wheel_dec"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 通用步进单滚轮形态 -->
        <NumberPicker
            android:id="@+id/np_wheel"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="top"
            android:layout_marginTop="75dp"
            android:background="@color/picker_line" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="top"
            android:layout_marginTop="115dp"
            android:background="@color/picker_line" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp">

        <TextView
            android:id="@+id/np_clear"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/picker_clear"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/picker_clear_text"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/np_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/picker_cancel"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/picker_cancel_text"
            android:gravity="center" />

        <TextView
            android:id="@+id/np_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/picker_confirm"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_picker_primary"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
