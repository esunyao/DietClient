root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{bat,cmd}]
end_of_line = crlf

# Windows PowerShell 5.1 对含非 ASCII 字符的 UTF-8 BOM 更稳妥。
[*.ps1]
charset = utf-8-bom
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
